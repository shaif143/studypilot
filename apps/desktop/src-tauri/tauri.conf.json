{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyPilot",
  "version": "0.1.0",
  "identifier": "co.studypilot.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @studypilot/desktop",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build --workspace @studypilot/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StudyPilot",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": false
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/studypilot-api"
    ],
    "copyright": "\u00a9 StudyPilot",
    "category": "Education",
    "shortDescription": "Your university material, explained and examined.",
    "longDescription": "StudyPilot turns lecture PDFs into grounded explanations, quizzes and revision. Documents and progress stay on this Mac unless you explicitly enable a cloud model provider.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
