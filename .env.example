# StudyPilot hosted backend configuration.
# Copy to .env (git-ignored) or set these in your host's dashboard.
# Nothing here is read by the frontend; the browser bundle holds no secrets.

# --- Mode -------------------------------------------------------------------
# "hosted" requires a signing secret and real accounts. The desktop app sets
# this itself and should never use this file.
STUDYPILOT_DEPLOYMENT_MODE=hosted

# --- Identity (required in hosted mode) -------------------------------------
# Generate with:  openssl rand -base64 48
# Changing it signs everyone out. It must be identical across every instance.
STUDYPILOT_JWT_SECRET=

# How long a session lasts before re-authentication. Default: 14 days.
STUDYPILOT_ACCESS_TOKEN_HOURS=336

# Set to false once your own account exists, to close public sign-ups.
STUDYPILOT_ALLOW_REGISTRATION=true

# --- Database ---------------------------------------------------------------
# A PostgreSQL DSN. "postgres://" URLs and missing sslmode are corrected
# automatically. Leave empty only if this host has a persistent volume.
STUDYPILOT_DATABASE_URL=

# --- Object storage ---------------------------------------------------------
# Uploaded PDFs and rendered page previews. Required unless the host has a
# persistent volume: a container filesystem does not survive a redeploy.
STUDYPILOT_STORAGE_BACKEND=s3
STUDYPILOT_S3_BUCKET=
# Set for S3-compatible providers (Cloudflare R2, Backblaze B2, MinIO).
STUDYPILOT_S3_ENDPOINT_URL=
STUDYPILOT_S3_REGION=auto
STUDYPILOT_S3_PREFIX=
# Credentials use the standard AWS variables, read by boto3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Vector index -----------------------------------------------------------
# Embedded Qdrant writes to local disk and cannot be shared between instances.
STUDYPILOT_VECTOR_STORE=qdrant-remote
STUDYPILOT_QDRANT_URL=
STUDYPILOT_QDRANT_API_KEY=

# --- Models -----------------------------------------------------------------
# Default: no generation. The tutor quotes the student's own material with
# citations and says plainly that it is quoting, not explaining.
STUDYPILOT_LLM_PROVIDER=extractive
# For real explanations, pick one and supply its key:
#   STUDYPILOT_LLM_PROVIDER=anthropic   + ANTHROPIC_API_KEY=
#   STUDYPILOT_LLM_PROVIDER=openai      + OPENAI_API_KEY=
# A cloud provider is still refused per request unless the user has turned on
# cloud processing in Settings.
STUDYPILOT_ALLOW_CLOUD_PROCESSING=false

# Embeddings. "hash" needs no download but matches wording rather than meaning;
# "model2vec" is ~30 MB and markedly better. Needs the local-models extra.
STUDYPILOT_EMBEDDING_PROVIDER=hash

# --- Limits and logging -----------------------------------------------------
STUDYPILOT_MAX_UPLOAD_BYTES=83886080
STUDYPILOT_LOG_LEVEL=INFO
# Leave false: document text, questions and answers are redacted from logs.
STUDYPILOT_LOG_SENSITIVE_CONTENT=false
