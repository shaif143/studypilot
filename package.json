{
  "name": "studypilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @studypilot/web",
    "dev:api": "scripts/dev-api.sh",
    "dev:desktop": "npm run tauri:dev --workspace @studypilot/desktop",
    "build": "npm run build --workspace @studypilot/web",
    "build:desktop": "npm run build:sidecar && npm run tauri:build --workspace @studypilot/desktop",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "test:e2e": "playwright test",
    "api:test": "scripts/api-test.sh",
    "api:lint": "scripts/api-lint.sh",
    "fixtures": ".venv/bin/python scripts/make_fixtures.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run api:lint && npm run api:test",
    "build:sidecar": "scripts/build-sidecar.sh",
    "build:dmg": "scripts/make-dmg.sh",
    "api:schema": ".venv/bin/python scripts/dump-openapi.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
